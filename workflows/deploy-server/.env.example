# deploy-server.sh — configuration
# Copy to .env, fill in values, then run: sudo bash deploy-server.sh

#   cp .env.example .env && nano .env

# Note: all variables must be present; some may be left blank (see per-variable
# comments). Values containing special characters ($, `, \, ") must be wrapped
# in single quotes to prevent shell expansion when the file is sourced.
# Example: DEPLOY_USER_PASSWORD='my$ecret!pass'

# ─────────────────────────────────────────────────────────
#  1. server-bootstrap.sh
# ─────────────────────────────────────────────────────────

# Installation profile — required, must be 1 or 2.
# 1 = base admin tools (htop, curl, wget, git, nano, etc.)
# 2 = base + hardware diagnostics (lm-sensors, smartmontools, inxi, etc.)
BOOTSTRAP_PROFILE=

# y = install firewalld and open SSH port | n = skip
BOOTSTRAP_FIREWALL=

# y = install and configure Fail2Ban | n = skip
BOOTSTRAP_FAIL2BAN=

# y = create a new sudo user after bootstrap | n = skip
CREATE_DEPLOY_USER=

# Username for the new sudo user.
# Required if CREATE_DEPLOY_USER=y.
# Ignored if CREATE_DEPLOY_USER=n.
DEPLOY_USER=

# Password for the new sudo user.
# Leave blank to create the account without a password.
# Must not contain ':' (chpasswd limitation).
# Ignored if CREATE_DEPLOY_USER=n.
DEPLOY_USER_PASSWORD=

# ─────────────────────────────────────────────────────────
#  2. deploy-nginx.sh
# ─────────────────────────────────────────────────────────

# y = install avahi-daemon (mDNS, makes server reachable as <hostname>.local) | n = skip
NGINX_AVAHI=

# y = install PHP and PHP-FPM | n = skip
NGINX_PHP=

# y = add /grafana reverse proxy block to nginx vhost | n = skip
NGINX_GRAFANA_PROXY=

# y = add /portainer reverse proxy block to nginx vhost | n = skip
NGINX_PORTAINER_PROXY=

# y = install firewalld and open HTTP/HTTPS ports | n = skip
# Set n if firewall was already configured in bootstrap above.
NGINX_FIREWALL=

# Server domain or IP for the nginx vhost.
# Leave blank to use the auto-detected local IP address.
NGINX_DOMAIN=

# ─────────────────────────────────────────────────────────
#  3. deploy-grafana.sh
# ─────────────────────────────────────────────────────────

# Grafana admin username.
# Leave blank to use the default 'admin'.
GRAFANA_USER=

# Grafana admin password.
# Leave blank to use the default 'admin' — change immediately after first login.
# Wrap in single quotes if the value contains special characters.
GRAFANA_PASSWORD=

# Domain used to build the Grafana root URL (https://<domain>/grafana/).
# Leave blank for localhost (no nginx hint block will be printed).
GRAFANA_DOMAIN=

# ─────────────────────────────────────────────────────────
#  4. deploy-portainer.sh
# ─────────────────────────────────────────────────────────

# Portainer admin password.
# Leave blank to use the default 'admin' — change immediately after first login.
# Note: the admin username in Portainer CE is always 'admin'.
# Wrap in single quotes if the value contains special characters.
PORTAINER_PASSWORD=

# Domain used to build the Portainer URL (https://<domain>/portainer/).
# Leave blank for localhost (no hint block will be printed).
PORTAINER_DOMAIN=
