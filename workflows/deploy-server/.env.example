# deploy-server.sh config
#
# Copy to .env and fill in: cp .env.example .env && nano .env
#
# Every step below is independently toggleable — set the matching
# DEPLOY_*/CREATE_* variable to "n" to skip that step entirely.
# Variables for a disabled step are ignored (but must still be present
# if you plan to flip it on later — the script only validates enabled steps).

# ==> Step 1: Firewalld
# Installs firewalld (standalone/install/apt/cli/install-firewalld-cli.sh).
# Enable this before DEPLOY_SSH/DEPLOY_NGINX if you want their firewall
# prompts below to actually find firewalld installed.
# Accepts: y or n (case-insensitive). Anything else fails validation.

DEPLOY_FIREWALL=

# ==> Step 2: SSH hardening
# Runs standalone/deploy/deploy-ssh.sh.
# Accepts: y or n. Anything else fails validation.

DEPLOY_SSH=

# Allow SSH through firewalld when deploy-ssh.sh detects it installed.
# Accepts: y, yes, n, no, or empty (treated as "no"). Only read by the
# subscript if firewalld is present — otherwise ignored. Any other value
# is treated as invalid by the subscript and the prompt is skipped (no).

SSH_ALLOW_FIREWALL=

# ==> Step 3: Fail2Ban
# Runs standalone/deploy/deploy-fail2ban.sh (non-interactive, no config needed).
# Accepts: y or n. Anything else fails validation.

DEPLOY_FAIL2BAN=

# ==> Step 4: Deploy user
# Runs standalone/maintenance/create-user.sh + standalone/groups/grant-sudo.sh.
# Accepts: y or n. Anything else fails validation.

CREATE_DEPLOY_USER=

# Linux username. Cannot be empty. Standard adduser rules apply: lowercase
# letters, digits, underscore, hyphen; must start with a letter or underscore.

DEPLOY_USER=

# Any string. Forbidden: ':' (colon) — corrupts the "user:password" pair
# passed to chpasswd internally. May be left empty for no password (the
# account is created with a disabled password / key-only login).

DEPLOY_USER_PASSWORD=

# ==> Step 5: Nginx
# Runs standalone/deploy/deploy-nginx.sh.
# Accepts: y or n. Anything else fails validation.

DEPLOY_NGINX=

# Install avahi-daemon (mDNS / .local hostname resolution).
# Accepts: y, yes, n, no, or empty (treated as "no").

NGINX_AVAHI=

# Install PHP & PHP-FPM.
# Accepts: y, yes, n, no, or empty (treated as "no").

NGINX_PHP=

# Add an Nginx reverse-proxy block for Grafana at /grafana.
# Accepts: y, yes, n, no, or empty (treated as "no"). Only meaningful if
# DEPLOY_GRAFANA=y — the orchestrator warns (non-fatally) otherwise.

NGINX_GRAFANA_PROXY=

# Add an Nginx reverse-proxy block for Portainer at /portainer.
# Accepts: y, yes, n, no, or empty (treated as "no"). Only meaningful if
# DEPLOY_PORTAINER=y — the orchestrator warns (non-fatally) otherwise.

NGINX_PORTAINER_PROXY=

# Add an Nginx reverse-proxy block for File Browser at /files.
# Accepts: y, yes, n, no, or empty (treated as "no"). Only meaningful if
# DEPLOY_FILEBROWSER=y — the orchestrator warns (non-fatally) otherwise.

NGINX_FILEBROWSER_PROXY=

# Install firewalld and allow HTTP/HTTPS/mDNS through it.
# Accepts: y, yes, n, no, or empty (treated as "no"). Safe to set "y" even
# if DEPLOY_FIREWALL already installed firewalld — apt reinstall is a no-op.

NGINX_FIREWALL=

# Domain name or IPv4 address. Allowed characters: letters, digits, dots,
# hyphens (regex: ^([A-Za-z0-9.-]+|([0-9]{1,3}\.){3}[0-9]{1,3})$). Anything
# else is rejected by the subscript. Leave empty to use the server's local IP.

NGINX_DOMAIN=

# ==> Step 6: Grafana
# Runs standalone/deploy/deploy-grafana.sh.
# Accepts: y or n. Anything else fails validation.

DEPLOY_GRAFANA=

# Grafana admin username. No format restriction enforced by the subscript,
# but avoid ':' — it's used as "user:password" in an internal curl basic-auth
# call (colon in the password alone is fine there, only the username matters).
# Leave empty to default to 'admin'.

GRAFANA_USER=

# Any string. Leave empty to default to 'admin' (a default-credential warning
# is printed at the end of the subscript's summary in that case).

GRAFANA_PASSWORD=

# Domain name (e.g. example.com). No format enforced by the subscript, but
# avoid spaces/slashes/quotes since it's written directly into config and
# URLs. Leave empty for localhost-only access (no reverse-proxy hint shown).

GRAFANA_DOMAIN=

# ==> Step 7: Portainer
# Runs standalone/deploy/deploy-portainer.sh.
# Accepts: y or n. Anything else fails validation.

DEPLOY_PORTAINER=

# Any string. Leave empty to default to 'admin' (a default-credential warning
# is printed at the end of the subscript's summary in that case).

PORTAINER_PASSWORD=

# Domain name (e.g. example.com). No format enforced by the subscript, but
# avoid spaces/slashes/quotes since it's written directly into config and
# URLs. Leave empty for localhost-only access (no reverse-proxy hint shown).

PORTAINER_DOMAIN=

# ==> Step 8: File Browser
# Runs standalone/deploy/deploy-filebrowser.sh.
# Accepts: y or n. Anything else fails validation.

DEPLOY_FILEBROWSER=

# File Browser admin username. No format restriction enforced by the
# subscript. Leave empty to default to 'admin'.

FILEBROWSER_USER=

# File Browser admin password.
# File Browser enforces password length of 12 characters.
# Validate it here to avoid a failed bootstrap later.

FILEBROWSER_PASSWORD=

# Domain name (e.g. example.com). No format enforced by the subscript, but
# avoid spaces/slashes/quotes since it's written directly into config and
# URLs. Leave empty for localhost-only access (no reverse-proxy hint shown).

FILEBROWSER_DOMAIN=
